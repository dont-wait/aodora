[
  {
    "create": "categories",
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["name", "slug", "is_active", "created_at", "updated_at"],
        "properties": {
          "name": { "bsonType": "string", "minLength": 1 },
          "slug": { "bsonType": "string", "minLength": 1 },
          "description": { "bsonType": ["string", "null"] },
          "parent_id": { "bsonType": ["objectId", "null"] },
          "is_active": { "bsonType": "bool" },
          "created_at": { "bsonType": "date" },
          "updated_at": { "bsonType": "date" }
        }
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  },
  {
    "create": "products",
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["name", "slug", "category_id", "price", "stock", "is_active", "created_at", "updated_at"],
        "properties": {
          "name": { "bsonType": "string", "minLength": 1 },
          "slug": { "bsonType": "string", "minLength": 1 },
          "description": { "bsonType": ["string", "null"] },
          "category_id": { "bsonType": "objectId" },
          "price": { "bsonType": ["int", "long", "decimal"], "minimum": 0 },
          "compare_at_price": { "bsonType": ["int", "long", "decimal", "null"], "minimum": 0 },
          "images": { "bsonType": "array", "items": { "bsonType": "string" } },
          "variants": {
            "bsonType": "array",
            "items": {
              "bsonType": "object",
              "required": ["sku", "size", "color", "stock"],
              "properties": {
                "sku": { "bsonType": "string", "minLength": 1 },
                "size": { "bsonType": "string" },
                "color": { "bsonType": "string" },
                "stock": { "bsonType": ["int", "long"], "minimum": 0 }
              }
            }
          },
          "stock": { "bsonType": ["int", "long"], "minimum": 0 },
          "is_active": { "bsonType": "bool" },
          "created_at": { "bsonType": "date" },
          "updated_at": { "bsonType": "date" }
        }
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  },
  {
    "create": "customers",
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["full_name", "email", "password_hash", "created_at", "updated_at"],
        "properties": {
          "full_name": { "bsonType": "string", "minLength": 1 },
          "email": { "bsonType": "string", "minLength": 3 },
          "password_hash": { "bsonType": "string", "minLength": 1 },
          "phone": { "bsonType": ["string", "null"] },
          "addresses": {
            "bsonType": "array",
            "items": {
              "bsonType": "object",
              "required": ["recipient", "phone", "line1", "city"],
              "properties": {
                "recipient": { "bsonType": "string" },
                "phone": { "bsonType": "string" },
                "line1": { "bsonType": "string" },
                "ward": { "bsonType": ["string", "null"] },
                "district": { "bsonType": ["string", "null"] },
                "city": { "bsonType": "string" },
                "is_default": { "bsonType": "bool" }
              }
            }
          },
          "created_at": { "bsonType": "date" },
          "updated_at": { "bsonType": "date" }
        }
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  },
  {
    "create": "orders",
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["customer_id", "items", "subtotal", "shipping_fee", "total", "status", "payment_method", "payment_status", "shipping_address", "created_at", "updated_at"],
        "properties": {
          "customer_id": { "bsonType": "objectId" },
          "items": {
            "bsonType": "array",
            "minItems": 1,
            "items": {
              "bsonType": "object",
              "required": ["product_id", "product_name", "sku", "quantity", "unit_price"],
              "properties": {
                "product_id": { "bsonType": "objectId" },
                "product_name": { "bsonType": "string" },
                "sku": { "bsonType": "string" },
                "size": { "bsonType": ["string", "null"] },
                "color": { "bsonType": ["string", "null"] },
                "quantity": { "bsonType": ["int", "long"], "minimum": 1 },
                "unit_price": { "bsonType": ["int", "long", "decimal"], "minimum": 0 }
              }
            }
          },
          "subtotal": { "bsonType": ["int", "long", "decimal"], "minimum": 0 },
          "shipping_fee": { "bsonType": ["int", "long", "decimal"], "minimum": 0 },
          "total": { "bsonType": ["int", "long", "decimal"], "minimum": 0 },
          "status": { "enum": ["pending", "confirmed", "shipping", "delivered", "cancelled"] },
          "payment_method": { "enum": ["cod", "bank_transfer", "card", "e_wallet"] },
          "payment_status": { "enum": ["unpaid", "paid", "refunded"] },
          "shipping_address": {
            "bsonType": "object",
            "required": ["recipient", "phone", "line1", "city"],
            "properties": {
              "recipient": { "bsonType": "string" },
              "phone": { "bsonType": "string" },
              "line1": { "bsonType": "string" },
              "ward": { "bsonType": ["string", "null"] },
              "district": { "bsonType": ["string", "null"] },
              "city": { "bsonType": "string" }
            }
          },
          "note": { "bsonType": ["string", "null"] },
          "created_at": { "bsonType": "date" },
          "updated_at": { "bsonType": "date" }
        }
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  },
  {
    "create": "carts",
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["customer_id", "items", "created_at", "updated_at"],
        "properties": {
          "customer_id": { "bsonType": "objectId" },
          "items": {
            "bsonType": "array",
            "items": {
              "bsonType": "object",
              "required": ["product_id", "sku", "quantity"],
              "properties": {
                "product_id": { "bsonType": "objectId" },
                "sku": { "bsonType": "string" },
                "quantity": { "bsonType": ["int", "long"], "minimum": 1 },
                "added_at": { "bsonType": "date" }
              }
            }
          },
          "created_at": { "bsonType": "date" },
          "updated_at": { "bsonType": "date" }
        }
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  },
  {
    "create": "reviews",
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["product_id", "customer_id", "rating", "created_at", "updated_at"],
        "properties": {
          "product_id": { "bsonType": "objectId" },
          "customer_id": { "bsonType": "objectId" },
          "rating": { "bsonType": ["int", "long"], "minimum": 1, "maximum": 5 },
          "comment": { "bsonType": ["string", "null"] },
          "created_at": { "bsonType": "date" },
          "updated_at": { "bsonType": "date" }
        }
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  },
  {
    "createIndexes": "categories",
    "indexes": [
      { "key": { "slug": 1 }, "name": "uq_categories_slug", "unique": true },
      { "key": { "parent_id": 1, "is_active": 1 }, "name": "ix_categories_parent_active" }
    ]
  },
  {
    "createIndexes": "products",
    "indexes": [
      { "key": { "slug": 1 }, "name": "uq_products_slug", "unique": true },
      { "key": { "category_id": 1, "is_active": 1 }, "name": "ix_products_category_active" },
      { "key": { "name": "text", "description": "text" }, "name": "ix_products_search" }
    ]
  },
  {
    "createIndexes": "customers",
    "indexes": [
      { "key": { "email": 1 }, "name": "uq_customers_email", "unique": true },
      { "key": { "phone": 1 }, "name": "ix_customers_phone", "sparse": true }
    ]
  },
  {
    "createIndexes": "orders",
    "indexes": [
      { "key": { "customer_id": 1, "created_at": -1 }, "name": "ix_orders_customer_created" },
      { "key": { "status": 1, "created_at": -1 }, "name": "ix_orders_status_created" }
    ]
  },
  {
    "createIndexes": "carts",
    "indexes": [
      { "key": { "customer_id": 1 }, "name": "uq_carts_customer", "unique": true }
    ]
  },
  {
    "createIndexes": "reviews",
    "indexes": [
      { "key": { "product_id": 1, "created_at": -1 }, "name": "ix_reviews_product_created" },
      { "key": { "customer_id": 1, "product_id": 1 }, "name": "uq_reviews_customer_product", "unique": true }
    ]
  }
]
