[
  {
    "collMod": "orders",
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "items",
          "subtotal",
          "shipping_fee",
          "total",
          "status",
          "payment_method",
          "payment_status",
          "shipping_address",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "customer_id": {
            "bsonType": [
              "objectId",
              "null"
            ]
          },
          "items": {
            "bsonType": "array",
            "minItems": 1,
            "items": {
              "bsonType": "object",
              "required": [
                "product_id",
                "product_name",
                "sku",
                "quantity",
                "unit_price"
              ],
              "properties": {
                "product_id": {
                  "bsonType": "objectId"
                },
                "product_name": {
                  "bsonType": "string"
                },
                "sku": {
                  "bsonType": "string"
                },
                "size": {
                  "bsonType": [
                    "string",
                    "null"
                  ]
                },
                "color": {
                  "bsonType": [
                    "string",
                    "null"
                  ]
                },
                "quantity": {
                  "bsonType": [
                    "int",
                    "long"
                  ],
                  "minimum": 1
                },
                "unit_price": {
                  "bsonType": [
                    "int",
                    "long",
                    "decimal"
                  ],
                  "minimum": 0
                },
                "color_hex": {
                  "bsonType": [
                    "string",
                    "null"
                  ]
                },
                "variant_id": {
                  "bsonType": [
                    "string",
                    "null"
                  ]
                },
                "fulfillment_mode": {
                  "enum": [
                    "ready",
                    "custom"
                  ]
                },
                "measurements": {
                  "bsonType": "object",
                  "properties": {
                    "body": {
                      "bsonType": [
                        "string",
                        "null"
                      ]
                    },
                    "neck_cm": {
                      "bsonType": [
                        "int",
                        "long",
                        "double",
                        "decimal"
                      ],
                      "minimum": 0
                    },
                    "bust_cm": {
                      "bsonType": [
                        "int",
                        "long",
                        "double",
                        "decimal"
                      ],
                      "minimum": 0
                    },
                    "waist_cm": {
                      "bsonType": [
                        "int",
                        "long",
                        "double",
                        "decimal"
                      ],
                      "minimum": 0
                    },
                    "hips_cm": {
                      "bsonType": [
                        "int",
                        "long",
                        "double",
                        "decimal"
                      ],
                      "minimum": 0
                    },
                    "shoulder_cm": {
                      "bsonType": [
                        "int",
                        "long",
                        "double",
                        "decimal"
                      ],
                      "minimum": 0
                    },
                    "sleeve_cm": {
                      "bsonType": [
                        "int",
                        "long",
                        "double",
                        "decimal"
                      ],
                      "minimum": 0
                    },
                    "garment_length_cm": {
                      "bsonType": [
                        "int",
                        "long",
                        "double",
                        "decimal"
                      ],
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "subtotal": {
            "bsonType": [
              "int",
              "long",
              "decimal"
            ],
            "minimum": 0
          },
          "shipping_fee": {
            "bsonType": [
              "int",
              "long",
              "decimal"
            ],
            "minimum": 0
          },
          "total": {
            "bsonType": [
              "int",
              "long",
              "decimal"
            ],
            "minimum": 0
          },
          "status": {
            "enum": [
              "pending",
              "confirmed",
              "shipping",
              "delivered",
              "cancelled"
            ]
          },
          "payment_method": {
            "enum": [
              "cod",
              "bank_transfer",
              "card",
              "e_wallet",
              "cash_at_counter"
            ]
          },
          "payment_status": {
            "enum": [
              "unpaid",
              "paid",
              "refunded"
            ]
          },
          "shipping_address": {
            "bsonType": "object",
            "required": [
              "recipient",
              "phone"
            ],
            "properties": {
              "recipient": {
                "bsonType": "string"
              },
              "phone": {
                "bsonType": "string"
              },
              "line1": {
                "bsonType": "string"
              },
              "ward": {
                "bsonType": [
                  "string",
                  "null"
                ]
              },
              "district": {
                "bsonType": [
                  "string",
                  "null"
                ]
              },
              "city": {
                "bsonType": "string"
              }
            }
          },
          "note": {
            "bsonType": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "bsonType": "date"
          },
          "updated_at": {
            "bsonType": "date"
          },
          "order_number": {
            "bsonType": "string"
          },
          "fulfillment_mode": {
            "enum": [
              "ready",
              "custom"
            ]
          },
          "tailoring_request_id": {
            "bsonType": [
              "objectId",
              "null"
            ]
          },
          "measurement_profile": {
            "bsonType": "object",
            "properties": {
              "body": {
                "bsonType": [
                  "string",
                  "null"
                ]
              },
              "neck_cm": {
                "bsonType": [
                  "int",
                  "long",
                  "double",
                  "decimal"
                ],
                "minimum": 0
              },
              "bust_cm": {
                "bsonType": [
                  "int",
                  "long",
                  "double",
                  "decimal"
                ],
                "minimum": 0
              },
              "waist_cm": {
                "bsonType": [
                  "int",
                  "long",
                  "double",
                  "decimal"
                ],
                "minimum": 0
              },
              "hips_cm": {
                "bsonType": [
                  "int",
                  "long",
                  "double",
                  "decimal"
                ],
                "minimum": 0
              },
              "shoulder_cm": {
                "bsonType": [
                  "int",
                  "long",
                  "double",
                  "decimal"
                ],
                "minimum": 0
              },
              "sleeve_cm": {
                "bsonType": [
                  "int",
                  "long",
                  "double",
                  "decimal"
                ],
                "minimum": 0
              },
              "garment_length_cm": {
                "bsonType": [
                  "int",
                  "long",
                  "double",
                  "decimal"
                ],
                "minimum": 0
              }
            }
          },
          "guest_access_hash": {
            "bsonType": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "checkout": {
            "bsonType": "object",
            "required": [
              "scope",
              "request_id",
              "request_hash"
            ],
            "properties": {
              "scope": {
                "bsonType": "string",
                "pattern": "^(customer:[0-9a-f]{24}|guest:[0-9a-f]{64})$"
              },
              "request_id": {
                "bsonType": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "request_hash": {
                "bsonType": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      },
      "$or": [
        {
          "payment_method": "cash_at_counter",
          "shipping_fee": 0
        },
        {
          "payment_method": {
            "$ne": "cash_at_counter"
          },
          "$jsonSchema": {
            "properties": {
              "shipping_address": {
                "required": [
                  "line1",
                  "city"
                ]
              }
            }
          }
        }
      ],
      "$and": [
        {
          "$or": [
            {
              "checkout": {
                "$exists": false
              }
            },
            {
              "payment_method": {
                "$in": [
                  "cod",
                  "cash_at_counter"
                ]
              }
            }
          ]
        },
        {
          "$or": [
            {
              "checkout": {
                "$exists": false
              }
            },
            {
              "customer_id": {
                "$type": "objectId"
              },
              "guest_access_hash": {
                "$exists": false
              }
            },
            {
              "customer_id": null,
              "guest_access_hash": {
                "$type": "string"
              }
            }
          ]
        },
        {
          "$expr": {
            "$cond": [
              {
                "$eq": [
                  {
                    "$type": "$checkout"
                  },
                  "object"
                ]
              },
              {
                "$eq": [
                  "$checkout.scope",
                  {
                    "$cond": [
                      {
                        "$eq": [
                          {
                            "$type": "$customer_id"
                          },
                          "objectId"
                        ]
                      },
                      {
                        "$concat": [
                          "customer:",
                          {
                            "$toString": "$customer_id"
                          }
                        ]
                      },
                      {
                        "$concat": [
                          "guest:",
                          {
                            "$convert": {
                              "input": "$guest_access_hash",
                              "to": "string",
                              "onError": "",
                              "onNull": ""
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              true
            ]
          }
        }
      ]
    },
    "validationLevel": "strict",
    "validationAction": "error"
  },
  {
    "createIndexes": "orders",
    "indexes": [
      {
        "key": {
          "checkout.scope": 1,
          "checkout.request_id": 1
        },
        "name": "uq_orders_checkout_scope_request",
        "unique": true,
        "partialFilterExpression": {
          "checkout.scope": {
            "$type": "string"
          },
          "checkout.request_id": {
            "$type": "string"
          }
        }
      }
    ]
  }
]
