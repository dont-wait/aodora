# Values in the process environment take precedence over this file.
HTTP_ADDR=:8080
LOG_FORMAT=json
LOG_LEVEL=info

MONGO_URI=mongodb://aodora:aodora@localhost:27017/?authSource=admin
MONGO_DB=QuanLyBanQuanAo
MONGO_ROOT_USERNAME=aodora
MONGO_ROOT_PASSWORD=aodora
MONGO_DATA_VOLUME=server_mongo_data

# Local image storage (Docker Compose). Ports avoid Anomaly's 9000/9001.
RUSTFS_IMAGE=rustfs/rustfs:latest
RUSTFS_API_PORT=9100
RUSTFS_CONSOLE_PORT=9101
RUSTFS_ACCESS_KEY=aodoraadmin
RUSTFS_SECRET_KEY=aodora-local-secret
RUSTFS_BUCKET=aodora-images
# Optional public bucket URL used by the seeder; blank derives localhost + port + bucket.
RUSTFS_PUBLIC_URL=

# Optional Navicat browser desktop (make navicat-up).
NAVICAT_WEB_PORT=9443
NAVICAT_WEB_USER=aodora
NAVICAT_WEB_PASSWORD=navicat-local
NAVICAT_PUID=1000
NAVICAT_PGID=1000
